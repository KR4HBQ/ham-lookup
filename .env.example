# ── QRZ.com XML API ───────────────────────────────────────────────────────────
# Requires an active QRZ XML subscription (paid) for full data.
# Without a subscription you still get basic callsign data.
QRZ_USER=your_qrz_username
QRZ_PASS=your_qrz_password

# ── HamQTH XML API ────────────────────────────────────────────────────────────
# Free account at https://www.hamqth.com/register.php
HAMQTH_USER=your_hamqth_username
HAMQTH_PASS=your_hamqth_password

# ── QRZCQ XML API ─────────────────────────────────────────────────────────────
# Free account at https://www.qrzcq.com
QRZCQ_USER=your_qrzcq_username
QRZCQ_PASS=your_qrzcq_password

# ── Clublog DXCC Lookup ───────────────────────────────────────────────────────
# Free API key — apply at https://clublog.org/requestapikey.php
CLUBLOG_API_KEY=your_clublog_api_key

# ── Wavelog Integration ───────────────────────────────────────────────────────
# Your self-hosted Wavelog instance base URL (no trailing slash)
WAVELOG_URL=https://your-wavelog-instance.example.com
# API key from Wavelog → Settings → API
WAVELOG_KEY=your_wavelog_api_key
# Optional: logbook public slug (leave blank to use default logbook)
WAVELOG_SLUG=
# Station Location ID to log QSOs to (Wavelog → Station Locations). Default: 1
WAVELOG_STATION_ID=1

# ── MapTiler (interactive maps) ──────────────────────────────────────────────
# Free API key at https://cloud.maptiler.com/account/keys/
MAPTILER_API_KEY=your_maptiler_api_key

# ── Operator Configuration ────────────────────────────────────────────────────
# Your own Maidenhead grid square — used to calculate beam headings
MY_GRID=AA00aa

# ── Anthropic API (optional) ──────────────────────────────────────────────────
# Enables the notability check on callsign history. Leave blank to disable.
ANTHROPIC_API_KEY=

# ── Contact for API etiquette (optional) ──────────────────────────────────────
# Added to the User-Agent sent to Wikipedia and PSK Reporter, e.g. your email or website.
CONTACT_INFO=
