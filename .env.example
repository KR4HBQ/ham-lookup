# ── QRZ.com XML API ───────────────────────────────────────────────────────────
# Requires an active QRZ XML subscription (paid) for full data.
# Without a subscription you still get basic callsign data.
QRZ_USER=your_qrz_username
QRZ_PASS=your_qrz_password

# ── HamQTH XML API ────────────────────────────────────────────────────────────
# Free account at https://www.hamqth.com/register.php
HAMQTH_USER=your_hamqth_username
HAMQTH_PASS=your_hamqth_password

# ── QRZCQ XML API ─────────────────────────────────────────────────────────────
# Free account at https://www.qrzcq.com
QRZCQ_USER=your_qrzcq_username
QRZCQ_PASS=your_qrzcq_password

# ── Clublog DXCC Lookup ───────────────────────────────────────────────────────
# Free application API key — apply at https://clublog.org/requestapikey.php
# Also used to log QSOs to Club Log. It is issued to you per application: never commit or share it,
# Club Log revokes keys it finds published.
CLUBLOG_API_KEY=your_clublog_api_key

# ── Your log: worked-before history and Log QSO ──────────────────────────────
# LOG_SOURCE: where "worked before" history comes from (one of):
#   wavelog, qrz, clublog, lotw, wrl, adif   (or none)
# Leave it unset to use Wavelog when WAVELOG_URL and WAVELOG_KEY are set.
LOG_SOURCE=
# LOG_WRITE: loggers that new QSOs go to, comma separated, from:
#   wavelog, cloudlog, qrz, clublog, wrl          e.g. LOG_WRITE=wavelog,qrz
# Leave it unset to log to Wavelog when it is configured; set it empty to hide the Log QSO button.
# LoTW is read-only (it only accepts TQSL-signed uploads).
#LOG_WRITE=wavelog
# Minutes between refreshes of the cached log. Default depends on the source
# (Wavelog, QRZ, ADIF 5; Club Log, WRL 60; LoTW 360).
#LOG_REFRESH_MINUTES=
# The cache lives here (Docker: ./data, mounted by docker-compose.yml). It holds your QSOs.
#DATA_DIR=data

# Wavelog (read and write)
# Your self-hosted Wavelog instance base URL (no trailing slash)
WAVELOG_URL=https://your-wavelog-instance.example.com
# API key from Wavelog → Settings → API (read+write to log QSOs)
WAVELOG_KEY=your_wavelog_api_key
# Station Location ID to read from and log to (Wavelog → Station Locations). Default: 1
WAVELOG_STATION_ID=1

# Cloudlog (write only; Cloudlog has no export API, so for history export ADIF and use LOG_SOURCE=adif)
CLOUDLOG_URL=
CLOUDLOG_KEY=
CLOUDLOG_STATION_ID=

# QRZ Logbook (read and write). Needs a QRZ subscription.
# API key from QRZ Logbook → Settings. Not the same as QRZ_USER/QRZ_PASS above.
QRZ_LOGBOOK_KEY=

# Club Log
# Read: a REST token from Club Log → Settings → API (starts with cl_), and the log's callsign.
CLUBLOG_TOKEN=
CLUBLOG_CALLSIGN=
# Write (real-time upload): your Club Log email, an Application Password (Club Log → Settings →
# App Passwords, not your login password), CLUBLOG_CALLSIGN above and CLUBLOG_API_KEY below.
CLUBLOG_EMAIL=
CLUBLOG_APP_PASSWORD=

# LoTW (read only). Your LoTW website login. A full report can take minutes, so it is read every 6 hours.
LOTW_USERNAME=
LOTW_PASSWORD=
# Optional: only QSOs made as this callsign
LOTW_OWNCALL=

# World Radio League (read and write). Key from WRL → Integrations → Developer API (wrl_live_...).
# WRL keeps no QSL status, so the log check shows no confirmations. Logging needs a frequency.
WRL_API_KEY=
# Optional: logbook to log to (default: your default WRL logbook) and your station callsign
WRL_LOGBOOK_ID=
WRL_STATION_CALLSIGN=

# ADIF file or URL (read only). Any logger that exports ADIF: Cloudlog, N1MM, Log4OM, DXLab, ...
# A path relative to the app folder (in Docker put the file in ./data), or an http(s) URL.
ADIF_PATH=

# ── MapTiler (interactive maps) ──────────────────────────────────────────────
# Free API key at https://cloud.maptiler.com/account/keys/
MAPTILER_API_KEY=your_maptiler_api_key

# ── Operator Configuration ────────────────────────────────────────────────────
# Your own Maidenhead grid square — used to calculate beam headings
MY_GRID=AA00aa

# ── Anthropic API (optional) ──────────────────────────────────────────────────
# Enables the notability check on callsign history. Leave blank to disable.
ANTHROPIC_API_KEY=

# ── Password (optional) ───────────────────────────────────────────────────────
# Set this to make the browser ask for a password before showing Ham Lookup (any user name works).
# Leave blank for no password, e.g. on a home network or behind Cloudflare Access.
HAMLOOKUP_PASSWORD=

# ── Contact for API etiquette (optional) ──────────────────────────────────────
# Added to the User-Agent sent to Wikipedia and PSK Reporter, e.g. your email or website.
CONTACT_INFO=
